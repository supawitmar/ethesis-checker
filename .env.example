# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — อย่า commit ไฟล์ .env (มีใน .gitignore แล้ว)

# รหัสผ่านล็อกอินเจ้าหน้าที่ (จำเป็น — ถ้าเว้นว่างจะเข้าใช้ระบบไม่ได้)
APP_PASSWORD=

# ค่าปรับแต่งเพิ่มเติม (มี default อยู่แล้ว ไม่ตั้งก็ได้)
# MAX_UPLOAD_MB=25                    # ขนาดไฟล์อัปโหลดสูงสุด
# MAX_ACTIVE_JOBS=2                   # จำนวนงานตรวจพร้อมกันสูงสุด
# SESSION_SECRET=                     # ค่าสุ่มยาว ๆ สำหรับเซ็นคุกกี้เข้าสู่ระบบ (แนะนำ)
#                                     # ไม่ตั้งก็ใช้ได้ แต่ถ้าคุกกี้หลุด จะเอาไปเดารหัสผ่านได้ช้า ๆ
#                                     # สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
# COOKIE_SECURE=1                     # ตั้ง 1 เมื่อเสิร์ฟผ่าน HTTPS ที่ไม่ใช่ Render
#                                     # (รันในเครื่องผ่าน http ต้องไม่ตั้ง ไม่งั้นล็อกอินไม่ติด)
